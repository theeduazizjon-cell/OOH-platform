# Copy to .env for local development:  cp .env.example .env
# Values below match infrastructure/docker/docker-compose.yml.

NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
# Comma-separated list of browser origins allowed by CORS (the web app, later).
CORS_ORIGINS=http://localhost:5173

# Runtime connection: the restricted application role (no BYPASSRLS). Row-Level Security applies.
DATABASE_URL=postgres://ooh_app:ooh_app@localhost:5432/ooh
# Migrations/seeds connection: schema owner. Never used by the running API.
MIGRATION_DATABASE_URL=postgres://ooh:ooh@localhost:5432/ooh

REDIS_URL=redis://localhost:6379

# Access-token signing key (HS256). Generate your own: openssl rand -base64 48
JWT_SECRET=dev-only-secret-change-me-dev-only-secret-change-me
ACCESS_TOKEN_TTL_SECONDS=600
REFRESH_TOKEN_TTL_DAYS=30
# Refresh cookie "Secure" flag. Defaults to true in production. Browsers accept Secure cookies on
# http://localhost, but set false if you test from another host over plain http.
# COOKIE_SECURE=false
# Set true behind a reverse proxy/load balancer so client IPs come from X-Forwarded-For.
TRUST_PROXY=false

# Password for the demo users created by `pnpm db:seed`.
# SEED_PASSWORD=demo-password-change-me

# Optional: run integration tests against an existing PostgreSQL 18 + PostGIS server instead of
# starting a Testcontainers container. Must be a superuser URL; tests create and drop their own database.
# TEST_DATABASE_URL=postgres://ooh:ooh@localhost:5432/postgres
