{
  "name": "@ooh/api",
  "version": "0.0.0",
  "private": true,
  "description": "OOH Platform HTTP API (NestJS on Fastify).",
  "scripts": {
    "build": "nest build -p tsconfig.build.json",
    "dev": "nest start --watch -p tsconfig.build.json --exec \"node --env-file-if-exists=../../.env --enable-source-maps\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "13.1.1",
    "@nestjs/common": "11.2.6",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-fastify": "11.2.6",
    "@ooh/contracts": "workspace:*",
    "@ooh/db": "workspace:*",
    "drizzle-orm": "0.45.3",
    "fastify": "5.11.3",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "pino-http": "10.5.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/testing": "11.2.6",
    "@swc/core": "1.16.2",
    "pino-pretty": "13.1.3",
    "unplugin-swc": "1.6.0",
    "vitest": "3.2.7"
  }
}
