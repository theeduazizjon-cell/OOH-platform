{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": [
    "NODE_ENV",
    "CI",
    "LOG_LEVEL",
    "API_PORT",
    "CORS_ORIGINS",
    "DATABASE_URL",
    "MIGRATION_DATABASE_URL",
    "REDIS_URL",
    "TEST_DATABASE_URL",
    "DOCKER_HOST",
    "TESTCONTAINERS_*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
      "env": ["VITE_*"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "test:int": {
      "dependsOn": ["^build"],
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    }
  }
}
